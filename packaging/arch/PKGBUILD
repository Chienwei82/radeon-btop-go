# Maintainer: gputop contributors
#
# This recipe lives in the source tree it builds, under packaging/arch/, so the
# man page and the three completions it installs are the same files the
# repository carries. Build it from here:
#
#     cd packaging/arch
#     makepkg -si
#
# The build runs in podman (see AGENTS.md): the host needs no Go toolchain and
# never gets one. `source=()` is deliberate while the project URL is still the
# module-path placeholder; a release tarball can be added without changing the
# rest of the recipe once the owner settles the remote.

pkgname=gputop
pkgver=1.2.0
pkgrel=1
pkgdesc="A btop-style TUI monitor for AMD Radeon GPUs driven by the amdgpu kernel driver"
arch=('x86_64' 'aarch64')
url="https://github.com/gputop/gputop-go"
license=('GPL-3.0-or-later')
depends=()
makedepends=('podman')
optdepends=('radeontop: per-block utilisation panel')
options=('!debug')
source=()
sha256sums=()

_repo_root() {
  cd "${startdir}/../.."
}

build() {
  # Rebuild the pinned dev image on purpose: a stale image is a build that
  # passes for the wrong reason, the same rule CI follows.
  _repo_root
  ./scripts/podev.sh image
  ./scripts/podev.sh build
}

check() {
  _repo_root
  ./scripts/podev.sh test
}

package() {
  _repo_root
  install -Dm755 gputop "${pkgdir}/usr/bin/gputop"
  install -Dm644 packaging/man/gputop.1 "${pkgdir}/usr/share/man/man1/gputop.1"
  install -Dm644 packaging/completions/gputop.bash "${pkgdir}/usr/share/bash-completion/completions/gputop"
  install -Dm644 packaging/completions/gputop.zsh "${pkgdir}/usr/share/zsh/site-functions/_gputop"
  install -Dm644 packaging/completions/gputop.fish "${pkgdir}/usr/share/fish/vendor_completions.d/gputop.fish"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 NOTICE "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE"
}
